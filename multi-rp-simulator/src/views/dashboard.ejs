<!DOCTYPE html>
<html lang="<%= lang %>">
<%- include('head')-%>

<body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
  <%- include('header', { loginMigrationLoginLink, signInMenuLink })-%>
  <main property="mainContentOfPage" class="container dashboard-page">
    <div class="visible-xs mrgn-tp-md mrgn-bttm-md">
      <button type="button" class="btn btn-default btn-lg btn-block"><%= menu_label %></button>
    </div>

    <div class="row">
      <div class="col-md-8 col-lg-6">
        <h1 property="name" id="wb-cont" class="mrgn-tp-sm"><%= dashboard_heading %></h1>
        <p class="dashboard-intro"><%= dashboard_intro %></p>

        <ul class="list-unstyled dashboard-actions">
          <li><a href="#" class="dashboard-action-link"><%= dashboard_action_letters %></a></li>
          <li><a href="#" class="dashboard-action-link"><%= dashboard_action_applicant_info %></a></li>
          <li><a href="#" class="dashboard-action-link"><%= dashboard_action_update_access %></a></li>
        </ul>
      </div>
    </div>

    <%- include('preFooter')-%>
  </main>
  <%- include('footer')-%>

  <style>
    .dashboard-page {
      padding-top: 0.5rem;
    }

    #wb-cont {
      margin-bottom: 1rem;
      position: relative;
    }

    #wb-cont::after {
      content: "";
      display: block;
      width: 72px;
      border-bottom: 4px solid #a71d2a;
      margin-top: 0.6rem;
    }

    .dashboard-intro {
      margin-top: 1.2rem;
      margin-bottom: 1.2rem;
      max-width: 36ch;
    }

    .dashboard-actions {
      margin: 0;
      padding: 0;
      border-top: 1px solid #c9c9c9;
      max-width: 34rem;
    }

    .dashboard-actions li {
      border-bottom: 1px solid #c9c9c9;
      padding: 0.6rem 0;
    }

    .dashboard-action-link {
      color: #284162;
      font-size: 1.3em;
      text-decoration: underline;
      line-height: 1.4;
    }

    .dashboard-action-link:focus,
    .dashboard-action-link:hover {
      text-decoration-thickness: 3px;
    }

    @media (max-width: 767px) {
      .dashboard-page {
        padding-left: 15px;
        padding-right: 15px;
      }

      .dashboard-action-link {
        font-size: 1.2em;
      }
    }
  </style>
</body>
</html>
