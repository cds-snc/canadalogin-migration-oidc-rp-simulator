<!DOCTYPE html>
<html lang="<%= lang %>">
<%- include('head')-%>

<body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
  <%- include('header', { loginMigrationLoginLink, signInMenuLink })-%>
  <main property="mainContentOfPage" class="container">
    <div class="visible-xs mrgn-tp-md mrgn-bttm-md">
      <button type="button" class="btn btn-default btn-lg btn-block"><%= menu_label %></button>
    </div>

    <div class="row mrgn-tp-md">
      <div class="col-sm-12 col-md-10 col-lg-8">
        <h1 property="name" id="wb-cont" class="mrgn-tp-0"><%= dashboard_heading %></h1>
        <p class="mrgn-tp-md mrgn-bttm-lg"><%= dashboard_intro %></p>

        <ul class="list-unstyled mrgn-bttm-0">
          <li class="brdr-tp brdr-bttm">
            <p class="mrgn-tp-sm mrgn-bttm-sm"><a href="#"><%= dashboard_action_letters %></a></p>
          </li>
          <li class="brdr-bttm">
            <p class="mrgn-tp-sm mrgn-bttm-sm"><a href="#"><%= dashboard_action_applicant_info %></a></p>
          </li>
          <li class="brdr-bttm">
            <p class="mrgn-tp-sm mrgn-bttm-sm"><a href="#"><%= dashboard_action_update_access %></a></p>
          </li>
        </ul>

        <div class="mrgn-tp-xl">
          <%- include('preFooter')-%>
        </div>
      </div>
    </div>
  </main>
  <%- include('footer')-%>
</body>
</html>
