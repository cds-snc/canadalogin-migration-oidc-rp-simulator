<!DOCTYPE html>
<html lang="<%= lang %>">
<%- include('head')-%>

  <body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
    <%- include('header-dashboard', { loginMigrationLoginLink, signInMenuLink })-%>
      <main property="mainContentOfPage" class="container">
        <h1 property="name" id="wb-cont" class="mrgn-tp-0">
          <%= dashboard_heading %>
        </h1>
        <p class="mrgn-tp-md mrgn-bttm-lg">
          <%= dashboard_intro %>
        </p>
        <nav aria-label="<%= dashboard_heading %>">
          <ul class="list-unstyled mrgn-bttm-0">
            <li class="mrgn-bttm-md"><a href="#">
                <%= dashboard_action_letters %>
              </a></li>
            <li class="mrgn-bttm-md"><a href="#">
                <%= dashboard_action_applicant_info %>
              </a></li>
            <li><a href="#">
                <%= dashboard_action_update_access %>
              </a></li>
          </ul>
        </nav>
        <div class="mrgn-tp-xl">
          <%- include('preFooter')-%>
        </div>
      </main>
      <%- include('footer')-%>
        <style>
          a.application-bar {
            color: #fff;
            text-decoration: none;
          }

          a:hover.application-bar {
            text-decoration: underline;
          }

          .application-bar-links {
            display: block;
          }

          .application-bar-links a {
            display: block;
            margin-bottom: 5px;
          }

          @media (min-width: 768px) {
            .application-bar-links {
              display: flex;
              align-items: center;
              justify-content: flex-end;
              gap: 45px;
              margin-top: 0;
            }

            .application-bar-links a {
              display: inline-block;
              margin-bottom: 0;
            }
          }

          @media (max-width: 991px) {
            .application-bar-links {
              justify-content: flex-start;
              margin-bottom: 15px;
            }
          }
        </style>
  </body>

</html>
