<!DOCTYPE html>
<html lang="<%= lang %>">
<%- include('head')-%>

<body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
  <%- include('header', { loginMigrationLoginLink, signInMenuLink })-%>
  <main property="mainContentOfPage" class="container">
    <div class="row mrgn-tp-lg">
      <div class="col-sm-12 col-md-10 col-lg-9">
        <h1 property="name" id="wb-cont" class="mrgn-tp-0"><%= dashboard_heading %></h1>
        <p class="mrgn-tp-md mrgn-bttm-lg"><%= dashboard_intro %></p>

        <nav aria-label="<%= dashboard_heading %>">
          <ul class="list-unstyled mrgn-bttm-0">
            <li class="mrgn-bttm-md"><a href="#"><%= dashboard_action_letters %></a></li>
            <li class="mrgn-bttm-md"><a href="#"><%= dashboard_action_applicant_info %></a></li>
            <li><a href="#"><%= dashboard_action_update_access %></a></li>
          </ul>
        </nav>

        <div class="mrgn-tp-xl">
          <%- include('preFooter')-%>
        </div>
      </div>
    </div>
  </main>
  <%- include('footer')-%>
</body>
</html>
