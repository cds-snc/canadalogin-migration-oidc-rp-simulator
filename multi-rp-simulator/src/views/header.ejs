<header>
	<div id="wb-bnr" class="container">
		<div class="row">
			<section id="wb-lng" class="col-xs-3 col-sm-12 pull-right text-right">
				<h2 class="wb-inv"><%= language_selection_heading %></h2>
				<ul class="list-inline mrgn-bttm-0">
					<li>
						<a lang="<%= other_lang %>" hreflang="<%= other_lang %>" href="<%= language_link %>">
							<span class="hidden-xs"><%= language_label %></span>
							<abbr title="<%= language_label %>" class="visible-xs h3 mrgn-tp-sm mrgn-bttm-0 text-uppercase"><%= other_lang %></abbr>
						</a>
					</li>
				</ul>
			</section>

			<div class="brand col-xs-9 col-sm-5 col-md-4">
				<a href="<%= gc_link %>" property="url" aria-label="<%= gc_brand_link_aria_label %>">
					<img src="<%= ui_config.wet_cdts_hosturl %>/<%= ui_config.wet_cdts_version %>/wet-boew/assets/sig-blk-<%= lang %>.svg" alt="" aria-hidden="true">
				</a>
			</div>

			<section id="wb-srch" class="col-lg-offset-4 col-md-offset-4 col-sm-offset-2 col-xs-12 col-sm-5 col-md-4">
				<h2><%= search_label %></h2>
				<form action="#" method="post" name="cse-search-box" role="search">
					<div class="form-group wb-srch-qry">
						<label for="wb-srch-q" class="wb-inv"><%= search_title %> <%= canada_site_label %></label>
						<input id="wb-srch-q" list="wb-srch-q-ac" class="wb-srch-q form-control" name="q" type="search" value="" size="34" maxlength="170" placeholder="<%= search_title %> <%= canada_site_label %>">
					</div>
					<div class="form-group submit">
						<button type="submit" id="wb-srch-sub" class="btn btn-primary btn-small" name="wb-srch-sub"><span class="glyphicon-search glyphicon"></span><span class="wb-inv"><%= search_label %></span></button>
					</div>
				</form>
			</section>

			<section class="wb-mb-links col-xs-4 col-sm-3 visible-sm visible-xs" id="wb-glb-mn">
				<h2><%= mobile_menus_label %></h2>
				<ul class="list-inline text-right chvrn">
				  <li><a href="#mb-pnl" title="<%= mobile_menus_label %>" aria-controls="mb-pnl" class="overlay-lnk" role="button"><span class="glyphicon glyphicon-th-list"><span class="wb-inv"><%= mobile_menus_label %></span></span></a></li>
				</ul>
				<div id="mb-pnl"></div>
			</section>
		</div>
	</div>

</header>

<section class="application-bar">
	<div class="container">
		<div class="row">
			<div class="col-xs-12">
				<h2><%= appbar_rp_heading %></h2>
			</div>
		</div>
	</div>
</section>

<nav id="wb-bc" property="breadcrumb" aria-label="<%= breadcrumb_aria_label %>" aria-labelledby="wb-breadcrumb-nav">
	<h2 id="wb-breadcrumb-nav"><%= breadcrumb_heading %></h2>
	<div class="container">
		<ol class="breadcrumb">
			<li><a href="<%= home_link %>" title="<%= home_title %>"><%= home_label %></a></li>
			<% if (page === 'login') { %>
			<li><a href="#" title="<%= title_l %>"><%= title_l %></a></li>
			<% } else if (page === 'response') { %>
			<li><a href="#" title="<%= title_r %>"><%= title_r %></a></li>
			<% } %>
		</ol>
	</div>
</nav>
