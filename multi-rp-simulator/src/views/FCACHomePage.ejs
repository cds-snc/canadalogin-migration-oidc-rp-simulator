<!DOCTYPE html>

<html lang="<%= lang %>">
<%- include('head')-%>

<body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
  <%- include('header', { loginMigrationLoginLink, signInMenuLink })-%>
  <main property="mainContentOfPage" class="container">
    <div class="row profile">
      <div class="col-md-12">
        <h1 property="name" id="wb-cont"><%= testflows_title %></h1>
      </div>
    </div>

    <p><%= testflows_intro %></p>

    <div class="row mrgn-tp-lg">
      <div class="col-md-6">
        <div class="well well-sm brdr-rds-0">
          <h2 class="h4 mrgn-tp-0"><%= testing_all_heading %></h2>
          <p><%= testing_all_desc %></p>
          <% if (!flowAllPageLink) { %><p><%= testing_unavailable %></p><% } %>
          <p class="mrgn-tp-md">
            <% if (flowAllPageLink) { %>
            <a class="btn btn-primary btn-lg btn-block p-sm-3 mya" href="<%= flowAllPageLink %>">
              <span class="h4"><%= testing_open_all %></span>
            </a>
            <% } else { %>
            <button class="btn btn-primary btn-lg btn-block" disabled><%= testing_open_all %></button>
            <% } %>
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="well well-sm brdr-rds-0">
          <h2 class="h4 mrgn-tp-0"><%= testing_gckey_heading %></h2>
          <p><%= testing_gckey_desc %></p>
          <% if (!flowNoInteracPageLink) { %><p><%= testing_unavailable %></p><% } %>
          <p class="mrgn-tp-md">
            <% if (flowNoInteracPageLink) { %>
            <a class="btn btn-primary btn-lg btn-block p-sm-3 mya" href="<%= flowNoInteracPageLink %>">
              <span class="h4"><%= testing_open_gckey %></span>
            </a>
            <% } else { %>
            <button class="btn btn-primary btn-lg btn-block" disabled><%= testing_open_gckey %></button>
            <% } %>
          </p>
        </div>
      </div>
    </div>

    <% if (showDirectGccf) { %>
    <section class="panel panel-default">
      <div class="panel-body">
        <h2 class="h4 mrgn-tp-0"><%= testing_direct_gccf_heading %></h2>
        <p><%= testing_direct_gccf_description %></p>
        <% if (directGccfLink) { %>
        <a class="btn btn-default" href="<%= directGccfLink %>" onclick="submitWithQueryString(this)"><%= testing_direct_gccf_button %></a>
        <% } else { %>
        <p><%= testing_unavailable %></p>
        <button class="btn btn-default" disabled><%= testing_direct_gccf_button %></button>
        <% } %>
      </div>
    </section>
    <% } %>

    <div class="row">
      <div class="col-md-12">
        <div class="panel panel-info">
          <div class="panel-body">
            <h2 class="h4 mrgn-tp-0"><%= manual_client_selection_heading %></h2>
            <p><%= manual_client_selection_desc %></p>
            <p class="mrgn-bttm-0">
              <a class="btn btn-default" href="<%= manualClientSelectionLink %>">
                <%= manual_client_selection_button %>
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>

    <p><a href="<%= home_link %>"><%= testing_back %></a></p>
    <%- include('preFooter')-%>
  </main>
  <%- include('footer')-%>
</body>
</html>
