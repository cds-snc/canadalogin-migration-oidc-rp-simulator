			  <div class="col-xs-6 visible-sm visible-xs tofpg">
				<a href="#wb-cont"><%= goTopPage_label %> <span class="glyphicon glyphicon-chevron-up"></span></a>
			  </div>
			  <div class="wtrmrk align-self-end">
				<img src="<%= ui_config.wet_cdts_hosturl %>/<%= ui_config.wet_cdts_version %>/wet-boew/assets/wmms-blk.svg" alt="<%= footer_symbol_aria_label %>">
