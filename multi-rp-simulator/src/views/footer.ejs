					<li><a href="https://pm.gc.ca/fra"><%= footer_prime_minister_label %></a></li>
					<li><a href="https://www.canada.ca/fr/gouvernement/systeme.html"><%= footer_how_government_works_label %></a></li>
					<li><a href="https://ouvert.canada.ca/"><%= footer_open_government_label %></a></li>
				  </ul>
				</nav>
			</div>
		</div>
		<div class="gc-sub-footer">
		  <div class="container d-flex align-items-center">
			  <nav class="ftr-urlt-lnk" aria-label="<%= footer_about_site_aria_label %>" aria-labelledby="wb-footer-about-site">
				<h2 id="wb-footer-about-site" class="wb-inv"><%= footer_about_site_heading %></h2>
				<ul>
				  <li><a href="https://www.canada.ca/fr/sociaux.html"><%= footer_social_media_label %></a></li>
