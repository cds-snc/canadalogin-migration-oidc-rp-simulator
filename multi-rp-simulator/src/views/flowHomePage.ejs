<!DOCTYPE html>

<html lang="<%= lang %>">
<%- include('head')-%>

<body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
	<%- include('header', { loginMigrationLoginLink, signInMenuLink })-%>
	<main property="mainContentOfPage" class="container">
		<div class="row profile">
			<div class="col-md-12">
				<h1 property="name" id="wb-cont">Canadian Dental Care Plan Account</h1>
			</div>
		</div>

        <p>Your Canadian Dental Care Plan (CDCP) Account lets you start an application, check the status of your application, and receive your request reply electronically.</p>
        <div class="row">
            <div class="col-md-12 text-center">
                <img
                    src="/images/FCACHomePageImage.jpg"
                    alt="Canadian Dental Care Plan Account overview image"
                    class="img-responsive img-fluid"
                    style="margin-top: 1.5rem;"
                />
            </div>
        </div>
    <%- include('preFooter')-%>
	</main>
	<%- include('footer')-%>
</body></html>
