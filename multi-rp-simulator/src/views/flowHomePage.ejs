<!DOCTYPE html>

<html lang="<%= lang %>">
<%- include('head')-%>

<body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
	<%- include('header', { loginMigrationLoginLink, signInMenuLink })-%>
	<main property="mainContentOfPage" class="container">
		<div class="row profile">
			<div class="col-md-12">
				<h1 property="name" id="wb-cont"><%= fcac_portal_title %></h1>
			</div>
		</div>

        <p><%= fcac_portal_account_desc %></p>
        <div class="row">
            <div class="col-md-12 text-center">
                <img
                    src="/images/FCACHomePageImage.jpg"
                    alt="<%= fcac_portal_image_alt %>"
                    class="img-responsive img-fluid"
                    style="margin-top: 1.5rem;"
                />
            </div>
        </div>
    <%- include('preFooter')-%>
	</main>
	<%- include('footer')-%>
</body></html>
