<!DOCTYPE html>

<html lang="<%= lang %>">
<%- include('head')-%>

<body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
	<%- include('header', { loginMigrationLoginLink, signInMenuLink })-%>
	<main property="mainContentOfPage" class="container wet4-login-page">
		<div class="row profile">
			<div class="col-md-12">
				<h1 property="name" id="wb-cont"><%= content_title %> (<%= ui_config.client_label %>)</h1>
			</div>
		</div>
		<div class="row mrgn-tp-lg wet4-login-layout">
			<nav role="navigation" class="col-sm-12 col-md-4 col-lg-3" aria-label="<%= request_parameters_nav_aria_label %>">
				<div class="panel panel-default wet4-request-panel">
					<header class="panel-heading">
						<h2 class="panel-title"><%= request_parameters %></h2>
					</header>
					<div class="panel-body">
						<%- include('parameters')-%>
					</div>
				</div>
			</nav>
			<div class="col-sm-12 col-md-8 col-lg-9">
				<section>
					<div class="panel panel-info">
						<div class="panel-body">
							<p class="mrgn-tp-0 mrgn-bttm-md"><%= content_lnote %></p>

							<% oidc_clients.forEach((client) => { %>
							<div class="wet4-provider-row">
									<a class="btn btn-primary wet4-provider-btn" id="<%= client.name %>" href="/auth/<%= client.name %>/<%= lang %>" onclick="submitWithQueryString(this)"><%= signin %></a>
								<span class="wet4-provider-text"><% if (client.sic != false) { %><%= sic_label %> - <% } %><%= client.description %></span>
							</div>
							<% }); %>
						</div>
					</div>
				</section>
				<section class="mrgn-tp-md">
					<div class="panel panel-info">
					  <div class="panel-body small">
						  <%- include('parameters-help')-%>
					  </div>
					</div>
				</section>
			</div>
		</div>
		<%- include('preFooter')-%>
	</main>
	<%- include('footer')-%>

	<style>
		.wet4-login-page #wb-cont {
			margin-bottom: 0.6rem;
		}

		.wet4-request-panel {
			margin-bottom: 1.6rem;
		}

		.wet4-provider-row {
			display: flex;
			align-items: center;
			gap: 1.2rem;
			margin-bottom: 1rem;
		}

		.wet4-provider-row:last-child {
			margin-bottom: 0;
		}

		.wet4-provider-btn {
			min-width: 9.2rem;
			white-space: nowrap;
		}

		.wet4-provider-text {
			font-size: 1.08em;
			line-height: 1.35;
		}

		@media (max-width: 991px) {
			.wet4-provider-row {
				display: block;
			}

			.wet4-provider-btn {
				margin-bottom: 0.55rem;
			}
		}
	</style>
</body></html>
