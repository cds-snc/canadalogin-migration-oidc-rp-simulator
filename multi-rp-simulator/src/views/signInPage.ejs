<!DOCTYPE html>
<html lang="<%= lang %>">
   <%- include('head')-%>
   <body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
      <%- include('header', { loginMigrationLoginLink, signInMenuLink })-%>
      <main property="mainContentOfPage" class="container">
         <%
            const flowName = signInFlow === 'no-interac' ? 'no-interac' : 'all';
            const gcSigninClientName = gcSigninClient ? gcSigninClient.name : (oidc_clients[2] && oidc_clients[2].name);
            const gcKeyClientName = gcKeyClient ? gcKeyClient.name : (oidc_clients[1] && oidc_clients[1].name);
            const interacClientName = interacClient ? interacClient.name : gcKeyClientName;
         %>
         <div class="row profile">
            <div class="col-md-12">
               <h1 property="name" id="wb-cont"><%= fcac_signin_heading %></h1>
            </div>
            <div class="col-md-12">
               <fieldset class="mrgn-tp-sm">
                  <legend><%= signin_last_time_legend %></legend>
                  <p><%= signin_not_sure_hint %></p>
                  <div class="radio">
                     <label>
                     <input type="radio" name="signin" value="gc-signin" aria-controls="panel-gc-signin" aria-expanded="false">
                     <span class="text-bold"><%= canadalogin_label %></span><br>
                     <span class="text-muted"><%= email_password_label %></span>
                     </label>
                  </div>
                  <div class="radio">
                     <label>
                     <input type="radio" name="signin" value="gckey" aria-controls="panel-gckey" aria-expanded="false">
                     <span class="text-bold"><%= gckey_label %></span><br>
                     <span class="text-muted"><%= username_password_label %></span>
                     </label>
                  </div>
                  <% if (showInteracOption) { %>
                  <div class="radio">
                     <label>
                     <input type="radio" name="signin" value="interac" aria-controls="panel-interac" aria-expanded="false">
                     <span class="text-bold"><%= interac_partner_label %></span><br>
                     <span class="text-muted"><%= interac_banks_credit_unions_label %></span>
                     </label>
                  </div>
                  <% } %>
               </fieldset>
            </div>
            <div class="col-md-12">
               <div class="mrgn-tp-lg">
                  <!-- Section 1: GC Sign in -->
                  <section id="panel-gc-signin" class="signin-panel hidden" aria-hidden="true">
                     <h2 class="h3 mrgn-tp-0"><%= use_canadalogin_heading %></h2>
                     <p><%= redirect_canadalogin_text %></p>
                      <p class="mrgn-tp-md">
                        <a 
                            class="btn btn-primary" 
                            id="SignInWithGCSignIn-gcsignin" 
                            href="<%= gcSigninClientName ? '/auth/' + gcSigninClientName + '/' + lang + '?flow=' + flowName : '#' %>" 
                            onclick="submitWithQueryString(this)"
                            >
                            <span class="fas fa-sign-in-alt" aria-hidden="true"></span> 
                            <%= signin_with_canadalogin_button %>
                        </a> 
                     </p>
                  </section>
                  <!-- Section 2: GCKey -->
                  <section id="panel-gckey" class="signin-panel hidden" aria-hidden="true">
                     <h2 class="h3 mrgn-tp-0"><%= gckey_replaced_heading %></h2>
                     <p>
                        <%= migration_intro_prefix %> <strong><%= migration_intro_emphasis %></strong>
                     </p>
                     <ol class="gc-stepper" role="list">
                        <li class="gc-stepper__item is-current" aria-current="step">
                           <div class="gc-stepper__dot">
                              <span class="wb-inv"><%= stepper_current_step_1 %></span>
                           </div>
                           <div class="gc-stepper__title"><%= stepper_step_1 %></div>
                           <div class="gc-stepper__desc"><%= stepper_desc_1 %></div>
                        </li>
                        <li class="gc-stepper__item">
                           <div class="gc-stepper__dot">
                              <span class="wb-inv"><%= stepper_step_2 %></span>
                           </div>
                           <div class="gc-stepper__title"><%= stepper_step_2 %></div>
                           <div class="gc-stepper__desc"><%= stepper_desc_2 %></div>
                        </li>
                        <li class="gc-stepper__item">
                           <div class="gc-stepper__dot">
                              <span class="wb-inv"><%= stepper_step_3 %></span>
                           </div>
                           <div class="gc-stepper__title"><%= stepper_step_3 %></div>
                           <div class="gc-stepper__desc"><%= stepper_desc_3 %></div>
                        </li>
                     </ol>
                     
                     <h3 class="h4"><%= migration_step1_heading %></h3>
                     <p><%= migration_step1_desc %></p>
                     
                     <h3 class="h4"><%= migration_step2_gckey_heading %></h3>
                     <p><%= migration_step2_gckey_desc %></p>
                     
                     <h3 class="h4"><%= migration_step3_heading %></h3>
                     <p><%= migration_step3_desc %></p>
                     <p class="mrgn-tp-md">
                        <a 
                            class="btn btn-primary" 
                            id="SignInWithGCSignIn-gckey" 
                            href="<%= gcKeyClientName ? '/auth/' + gcKeyClientName + '/' + lang + '?flow=' + flowName : '#' %>" 
                            onclick="submitWithQueryString(this)"
                            >
                            <span class="fas fa-sign-in-alt" aria-hidden="true"></span> 
                            <%= migration_start_step1_button %>
                        </a> 
                     </p>

                     <!-- "For more information" block -->
                     <section class="alert alert-info mrgn-tp-lg" role="note">
                        <h3 class="h5 mrgn-tp-0"><%= migration_more_info_heading %></h3>
                        <p class="mrgn-bttm-0">
                           <a href="#" target="_blank" rel="noopener noreferrer">
                           <%= migration_update_signin_link_text %><span class="wb-inv"> <%= opens_new_tab_sr %></span>
                           </a>
                        </p>
                     </section>
                     </section>
                  <% if (showInteracOption) { %>
                  <!-- Section 3: Interac -->
                  <section id="panel-interac" class="signin-panel hidden" aria-hidden="true">
                     <h2 class="h3 mrgn-tp-0"><%= interac_replaced_heading %></h2>
                     <p>
                        <%= migration_intro_prefix %> <strong><%= migration_intro_emphasis %></strong>
                     </p>
                     <ol class="gc-stepper" role="list">
                        <li class="gc-stepper__item is-current" aria-current="step">
                           <div class="gc-stepper__dot">
                              <span class="wb-inv"><%= stepper_current_step_1 %></span>
                           </div>
                           <div class="gc-stepper__title"><%= stepper_step_1 %></div>
                           <div class="gc-stepper__desc"><%= stepper_desc_1 %></div>
                        </li>
                        <li class="gc-stepper__item">
                           <div class="gc-stepper__dot">
                              <span class="wb-inv"><%= stepper_step_2 %></span>
                           </div>
                           <div class="gc-stepper__title"><%= stepper_step_2 %></div>
                           <div class="gc-stepper__desc"><%= stepper_desc_2 %></div>
                        </li>
                        <li class="gc-stepper__item">
                           <div class="gc-stepper__dot">
                              <span class="wb-inv"><%= stepper_step_3 %></span>
                           </div>
                           <div class="gc-stepper__title"><%= stepper_step_3 %></div>
                           <div class="gc-stepper__desc"><%= stepper_desc_3 %></div>
                        </li>
                     </ol>
                     
                     <h3 class="h4"><%= migration_step1_heading %></h3>
                     <p><%= migration_step1_desc %></p>
                     
                     <h3 class="h4"><%= migration_step2_interac_heading %></h3>
                     <p><%= migration_step2_interac_desc %></p>
                     
                     <h3 class="h4"><%= migration_step3_heading %></h3>
                     <p><%= migration_step3_desc %></p>
                     
                     <p class="mrgn-tp-md">
                        <a 
                            class="btn btn-primary" 
                            id="SignInWithGCSignIn-interac" 
                            href="<%= interacClientName ? '/auth/' + interacClientName + '/' + lang + '?flow=' + flowName : '#' %>" 
                            onclick="submitWithQueryString(this)"
                            >
                            <span class="fas fa-sign-in-alt" aria-hidden="true"></span> 
                            <%= migration_start_step1_button %>
                        </a> 
                     </p>
                     <section class="alert alert-info mrgn-tp-lg" role="note">
                        <h3 class="h5 mrgn-tp-0"><%= migration_more_info_heading %></h3>
                        <p class="mrgn-bttm-0">
                           <a href="#" target="_blank" rel="noopener noreferrer">
                           <%= migration_update_signin_link_text %><span class="wb-inv"> <%= opens_new_tab_sr %></span>
                           </a>
                        </p>
                     </section>
                  </section>
                  <% } %>
               </div>
            </div>
         </div>
         <script>
            (function () {
                const radios = document.querySelectorAll('input[name="signin"]');
                const panels = document.querySelectorAll('.signin-panel');
            
                function hideAllPanels() {
                    panels.forEach(panel => {
                    panel.classList.add('hidden');
                    panel.setAttribute('aria-hidden', 'true');
                    });

                    radios.forEach(radio => {
                    radio.setAttribute('aria-expanded', 'false');
                    });
                }
            
                function showPanel(value) {
                    const panel = document.getElementById('panel-' + value);
                    if (!panel) return;

                    panel.classList.remove('hidden');
                    panel.setAttribute('aria-hidden', 'false');

                    const selectedRadio = document.querySelector('input[name="signin"][value="' + value + '"]');
                    if (selectedRadio) {
                    selectedRadio.setAttribute('aria-expanded', 'true');
                    }
                }
            
                radios.forEach(radio => {
                    radio.addEventListener('change', function () {
                    hideAllPanels();
                    showPanel(this.value);
                    });
            });
            
            // Optional: show panel if a radio is pre-selected
            const checked = document.querySelector('input[name="signin"]:checked');
            if (checked) {
                hideAllPanels();
                showPanel(checked.value);
            }
            })();
         </script>
         <style>
            .hidden {
  display: none !important;
}

            /* Screen-reader-only utility (WET uses .wb-inv; React version often used .sr-only) */
.sr-only,
.wb-inv {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* Wrapper spacing (optional) */
.gc-stepper-wrapper {
  margin-top: 1rem;
  margin-bottom: 1.5rem;
}

/* Layout */
.gc-stepper {
  display: flex;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 0;
  margin: 0;
}

/* center the rail within the item */
.gc-stepper__rail {
  display: flex;
  align-items: center;
  justify-content: center; /* key change */
  width: 100%;
  margin-bottom: 0.4rem;
}

.gc-stepper__item {
  list-style: none;
  position: relative;
  flex: 1 1 0;
  text-align: center;
  padding-top: 0.25rem;
}

/* Make the dot a positioning anchor */
.gc-stepper__dot {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  border: 3px solid #4b4b4b;
  background: #fff;
  margin: 0 auto 0.4rem;
  position: relative;
  z-index: 2;
  box-sizing: border-box;
}

/* Connector line: align to dot vertical center */
.gc-stepper__item:not(:last-child)::after {
  content: "";
  position: absolute;

  /* dot center = top of item + (dot height / 2) */
  top: calc(0.25rem + (2.5rem / 2) - 2px);

  /* start from the right edge of the dot */
  left: calc(50% + (2.5rem / 2));

  /* end at the next dot’s left edge */
  width: calc(100%);

  height: 4px;
  background: #4b4b4b;
  z-index: 1;
}

/* Completed step styling (filled dot + checkmark) */
.gc-stepper__item.is-complete .gc-stepper__dot {
  background: #2b50d9;
  border-color: #2b50d9;
}

/* Pure-CSS checkmark */
.gc-stepper__item.is-complete .gc-stepper__dot::after {
  content: "";
  position: absolute;
  width: 0.65rem;
  height: 1.1rem;
  border-right: 0.22rem solid #fff;
  border-bottom: 0.22rem solid #fff;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%) rotate(45deg);
}

/* Current step should not inherit completed fill */
.gc-stepper__item.is-current .gc-stepper__dot {
  background: #fff;
}

/* Current step styling */
.gc-stepper__item.is-current .gc-stepper__dot {
  border-color: #2b50d9;
}

.gc-stepper__item.is-current .gc-stepper__dot::after {
  content: "";
  width: 1rem;
  height: 1rem;
  border-radius: 50%;
  background: #2b50d9;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* Typography */
.gc-stepper__title {
  font-weight: 700;
  font-size: 1.125rem;
  line-height: 1.2;
  margin-bottom: 0.25rem;
}

.gc-stepper__desc {
  color: #4b4b4b;
  font-size: 1rem;
  line-height: 1.3;
  max-width: 14rem;
  margin: 0 auto;
}

/* Responsive: stack */
@media (max-width: 768px) {
  .gc-stepper {
    counter-reset: step;
    flex-direction: column;
    gap: 1rem;
  }

  .gc-stepper__item {
    counter-increment: step;
    text-align: left;
    padding-left: 3.25rem;
    padding-top: 0;
  }

  .gc-stepper__dot {
    position: absolute;
    left: 0;
    top: 0.15rem;
    margin: 0;
  }

  .gc-stepper__item:not(:last-child)::after {
    left: 1.15rem;

    /* start at bottom of the dot */
    top: calc(0.15rem + 2.5rem);

    width: 4px;

    /* extend through content + gap + up to the next dot (without overshooting) */
    height: calc(100% + 1rem);

    background: #4b4b4b;
  }

  .gc-stepper__desc {
    display: inline;
    max-width: none;
  }

  .gc-stepper__desc::before {
    content: counter(step) ". ";
    color: #000;
    font-weight: 700;
  }

  .gc-stepper__title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
}

         </style>
         <%- include('preFooter')-%>
      </main>
      <%- include('footer')-%>
   </body>
</html>
