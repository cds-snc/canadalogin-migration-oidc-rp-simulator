<!DOCTYPE html>

<html lang="<%= lang %>">
<%- include('head')-%>

<body onload="setOptionsValues()" vocab="http://schema.org/" typeof="WebPage" class="page-home">
	<%- include('header', { loginMigrationLoginLink, signInMenuLink }) %>
	<main property="mainContentOfPage" class="container">
		<div class="row profile">
			<div class="col-md-12">
				<h1 property="name" id="wb-cont"><%= fcac_portal_title %></h1>
			</div>
		</div>

        <p><%= fcac_portal_account_desc %></p>
        <div class="well well-sm brdr-rds-0 mrgn-tp-lg">
            <div class="panel panel-default mrgn-bttm-0 brdr-rds-0">
                <div class="panel-body">
                    <ul class="list-unstyled cnjnctn-type-or cnjnctn-md mrgn-tp-lg">
                        <li class="cnjnctn-col">
                            <h2 class="mrgn-tp-sm h4"><%= fcac_signin_option_heading %> <span class="wb-inv">: Option 1</span></h2>
                            <div class="mrgn-tp-md">
                                <p><a class="btn btn-primary btn-lg btn-block p-sm-3 mya" href="<%= signInPageLink %>" rel="noreferrer noopener"><span class="h4"><%= signin_button_label %><span class="wb-inv">: <%= signin_button_label %></span></span></a></p>
                            </div>
                        </li>
                        <li class="cnjnctn-col">
                            <h2 class="mrgn-tp-sm h4"><%= fcac_register_heading %> <span class="wb-inv">: Option 2</span></h2>
                            <div class="mrgn-tp-md">
                                <p>
                                    <% if (registerLink) { %>
                                      <a
                                          class="btn btn-default btn-lg btn-block p-sm-3 mya"
                                          id="RegisterInApp"
                                          href="<%= registerLink %>"
                                          onclick="submitWithQueryString(this)"
                                          >
                                          <span class="h4"><%= register_button_label %></span></a>
                                    <% } else { %>
                                      <button class="btn btn-default btn-lg btn-block p-sm-3 mya" disabled>
                                        <span class="h4"><%= register_button_label %></span>
                                      </button>
                                    <% } %>
                                </p>
                            </div>
                        </li>
                    </ul>

                </div>
            </div>
        </div>

    <%- include('preFooter')-%>
	</main>
	<%- include('footer')-%>
</body></html>
