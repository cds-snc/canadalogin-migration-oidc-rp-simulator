SESSION_SECRET=change-me
AUTH_EXTRA_PARAMETERS=fakeparam1=adasdasd&fakeparam2=adasdafdfshfd

# Optional dashboard "Manage CanadaLogin" link override.
# Locale-specific values take precedence over MANAGE_PROFILE_URL.
# If unset, the app derives a default from PUBLIC_BASE_URL:
# - https://rp-sim.migration.test.login-connexion.cdssandbox.xyz -> https://app.test.login-connexion.cdssandbox.xyz
# - https://rp-sim.migration.login-connexion.cdssandbox.xyz -> https://app.login-connexion.cdssandbox.xyz
# - https://rp-sim.migration.login-connexion.alpha.canada.ca -> https://app.login-connexion.alpha.canada.ca
# - https://rp-sim.migration.login-connexion.canada.ca -> https://app.login-connexion.canada.ca
# If a deployment needs a different path, set MANAGE_PROFILE_URL or MANAGE_PROFILE_URL_EN / MANAGE_PROFILE_URL_FR explicitly.
# MANAGE_PROFILE_URL=https://example.com/manage
# MANAGE_PROFILE_URL_EN=https://example.com/manage/en
# MANAGE_PROFILE_URL_FR=https://example.com/manage/fr

# Back-channel logout URIs are configured at the OP. Example per client:
# http://localhost:8080/backchannel-logout/client1
# http://localhost:8080/backchannel-logout/client2

